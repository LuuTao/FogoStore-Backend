DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-characters"
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-a-newly-rotated-token"
ALLOWED_ORIGINS="https://fogo-store.vercel.app"
AUTH_COOKIE_SAME_SITE="none"
AUTH_COOKIE_PARTITIONED="true"
SECURITY_LOG_EMAIL="security-admin@example.com"
SECURITY_LOG_PASSWORD="replace-with-a-strong-unique-password"
SECURITY_ALERT_EMAIL="security-alerts@example.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
EMAIL_USER="your-smtp-account@example.com"
EMAIL_PASS="your-smtp-app-password"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace-with-a-unique-password-of-14-or-more-characters"
ADMIN_SEED_PHONE="0900000000"
ADMIN_SEED_NAME="FoGo Super Admin"
ADMIN_SEED_ROTATE_PASSWORD="false"
